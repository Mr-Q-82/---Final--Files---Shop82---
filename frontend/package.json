{
  "name": "techstore-frontend-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build.mjs && node --env-file-if-exists=.env scripts/prerender.mjs",
    "build:production": "node --env-file-if-exists=.env scripts/validate-seo-env.mjs && npm run build",
    "build:assets": "node scripts/build.mjs",
    "prerender": "node --env-file-if-exists=.env scripts/prerender.mjs",
    "serve": "python dev_server.py",
    "lint": "node scripts/quality-check.mjs",
    "format:check": "node scripts/quality-check.mjs --format",
    "typecheck": "node scripts/type-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.js",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.55.0"
  }
}
